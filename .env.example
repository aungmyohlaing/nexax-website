# Public runtime (safe to expose). Override per environment on Cloud Run.
# Production defaults are baked into nuxt.config.ts when unset.
NUXT_PUBLIC_SITE_URL=https://www.nexaxtech.com
# Production default GTM. Set empty on staging to disable analytics.
NUXT_PUBLIC_GTM_ID=GTM-PQP878R2

# Resend (server-only). Required for /api/demo.
# Mapped by Nuxt into runtimeConfig (NUXT_RESEND_* only — no legacy RESEND_*).
# From address must be a verified domain/sender in Resend.
# All three are required — there is no baked-in recipient fallback.
NUXT_RESEND_API_KEY=re_xxxxxxxx
NUXT_RESEND_FROM="NexaXTech <noreply@nexaxtech.com>"
NUXT_RESEND_TO=amhlaing@gmail.com

# Staging example (Cloud Run / Secret Manager) — configure BEFORE first CI deploy:
# NUXT_PUBLIC_SITE_URL=https://staging.nexaxtech.com
# NUXT_PUBLIC_GTM_ID=
# NUXT_RESEND_API_KEY=<staging key>
# NUXT_RESEND_FROM="NexaXTech Staging <noreply@staging.nexaxtech.com>"
# NUXT_RESEND_TO=amhlaing@gmail.com
