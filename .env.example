# Resend (server-only). Required for /api/demo on Cloud Run.
# From address must be a verified domain/sender in Resend.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="NexaXTech <noreply@nexaxtech.com>"
# Optional — defaults to amhlaing@gmail.com
# RESEND_TO=amhlaing@gmail.com

# Nuxt also accepts these (same values):
# NUXT_RESEND_API_KEY=
# NUXT_RESEND_FROM=
# NUXT_RESEND_TO=

# Google Tag Manager. Optional on Cloud Run: the site default is GTM-PQP878R2.
# Set this to override that container, or leave it empty to disable the snippet.
# NUXT_PUBLIC_GTM_ID=GTM-PQP878R2
